# Central Hub environment template
# Copy to .env and adjust. Never commit real secrets.

CENTRAL_HUB_APP_NAME=Central Hub
CENTRAL_HUB_ENV=dev
CENTRAL_HUB_HOST=127.0.0.1
CENTRAL_HUB_PORT=8080
CENTRAL_HUB_DEBUG=true

# Absolute or relative path to the repository registry
CENTRAL_HUB_REPOSITORIES_CONFIG=config/repositories.yaml

# Repository Workspace Phase 1 (local browse / safe text edit / Git inspect)
# REPO_WS_MAX_PREVIEW_BYTES=1048576
# REPO_WS_MAX_EDIT_BYTES=524288
# REPO_WS_MAX_SEARCH_FILE_BYTES=262144
# REPO_WS_MAX_SEARCH_MATCHES=200
# REPO_WS_MAX_SEARCH_FILES=2000
# REPO_WS_MAX_TREE_ENTRIES=5000
# REPO_WS_MAX_TREE_DEPTH=16
# REPO_WS_GIT_TIMEOUT_SECONDS=8
# REPO_WS_OPEN_TIMEOUT_SECONDS=5

# Repository Workspace Phase 2 (approved run profiles — no unrestricted terminal)
# REPO_WS_RUN_PROFILES=config/run_profiles.yaml
# REPO_WS_PROFILE_DATABASE=data/repository_workspace.db
# REPO_WS_RUN_STATE_DIR=data/repository_runs/state
# REPO_WS_RUN_LOG_DIR=data/repository_runs/logs
# REPO_WS_RUN_LOG_MAX_BYTES=1048576
# REPO_WS_RUN_LOG_MAX_FILES=40
# Live write-capable / live_profile runs stay blocked unless explicitly enabled:
# REPO_WS_ALLOW_LIVE_RUNS=false

# Default timeout for HTTP / command health probes (seconds)
CENTRAL_HUB_REQUEST_TIMEOUT=5

# Dashboard reuses the last health probe set for this many seconds (0 = disable cache)
CENTRAL_HUB_HEALTH_CACHE_TTL=30

# Append-only audit log (created automatically)
CENTRAL_HUB_AUDIT_LOG=data/audit/audit.jsonl

# SQLite job database (Phase 2+)
CENTRAL_HUB_DATABASE=data/hub.db

# AI Assistant Center (read-only MVP; Aira Personal / Okarun Work)
# CENTRAL_HUB_AGENT_DATABASE=data/agent_center.db
# AGENT_CENTER_TIMEOUT_SECONDS=120
# Histories and summaries share this database but are isolated by profile_id.
# No environment switch enables assistant writes or execution.

# OpenAI API adapter (Responses API; never commit real keys)
OPENAI_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_DEFAULT_MODEL=
# OPENAI_ALLOWED_MODELS=
# OPENAI_MODEL_CACHE_TTL_SECONDS=300
# OPENAI_PRO_MODEL_TIMEOUT_SECONDS=600
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_SECONDS=120
# OPENAI_MAX_OUTPUT_TOKENS=4096
# OPENAI_MAX_TOOL_ROUNDS=8

# xAI Grok API adapter (Responses API; never commit real keys)
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_DEFAULT_MODEL=

# SQL Workspace (read-only query runner)
# Connection profiles: config/sql_connections.yaml (secrets via env below)
SQL_WS_MAX_ROWS=1000
SQL_WS_STATEMENT_TIMEOUT_MS=15000
SQL_WS_PAGE_SIZE=100
# Stage read-only role (optional)
# SQL_WS_STAGE_HOST=
# SQL_WS_STAGE_PORT=5432
# SQL_WS_STAGE_DATABASE=
# SQL_WS_STAGE_USER=
# SQL_WS_STAGE_PASSWORD=
# Live read-only role (optional — UI shows a strong Live warning)
# SQL_WS_LIVE_HOST=
# SQL_WS_LIVE_PORT=5432
# SQL_WS_LIVE_DATABASE=
# SQL_WS_LIVE_USER=
# SQL_WS_LIVE_PASSWORD=

# Flask session secret (change for any shared machine)
CENTRAL_HUB_SECRET_KEY=change-me-locally

# Optional owner token (Phase 6). Leave blank for open local single-user mode.
# When set, mutating job actions require matching session/header token.
CENTRAL_HUB_OWNER_TOKEN=

# Workspace Console — interactive repository terminal (PTY + WebSocket)
# WC_TERMINAL_ENABLED=true
# Opt-in: show/allow CMD alongside PowerShell on Windows (default false)
# WC_TERMINAL_ALLOW_CMD=true
# WC_TERMINAL_MAX_SESSIONS=8
# WC_TERMINAL_OUTPUT_BUFFER_BYTES=512000
# On Python 3.14+ Windows: set PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1 before pip install pywinpty

# Email Center — Gmail OAuth (read-only). Tokens encrypted with CENTRAL_HUB_SECRET_KEY.
# Create an OAuth web client in Google Cloud Console; enable Gmail API.
# Authorized redirect URI must match GMAIL_REDIRECT_URI exactly.
GMAIL_ENABLED=true
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8080/email/oauth/callback
# Enable Gmail API and Google Calendar API on the OAuth client.
# Calendar scopes are granted incrementally (calendar.calendarlist.readonly + calendar.events.readonly).
# Optional separate SQLite path (default data/email.db)
# CENTRAL_HUB_EMAIL_DATABASE=data/email.db

# Connected Live Processing (no secrets — host/path only)
# Start LP with: python lookup/app_lookup.py  (default 127.0.0.1:5050)
LIVE_PROCESSING_BASE_URL=http://127.0.0.1:5050
LIVE_PROCESSING_PATH=C:/PMNP/pmnp-live-processing

# Optional local checkouts (leave blank → Not Cloned until set; hub never auto-clones)
DATA_SCRIPT_PATH=
REPORT_TEMPLATE_PATH=

# --- DHIS2 (read-only foundation) ---
# Leave blank to keep DHIS2 pages in "not configured" mode.
DHIS2_ENABLED=true
# Prefer canonical vars when set (any of the three switches to canonical mode).
DHIS2_BASE_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
# Or select prefixed aliases already used by Live Processing (do not commit secrets):
# DHIS2_ENVIRONMENT=stage
# STAGE_DHIS2_URL=
# STAGE_DHIS2_USERNAME=
# STAGE_DHIS2_PASSWORD=
# DHIS2_ENVIRONMENT=live
# LIVE_DHIS2_URL=
# LIVE_DHIS2_USERNAME=
# LIVE_DHIS2_PASSWORD=

# DHIS2 Reports — Standard Report Manager Phase 1 + catalog shortcuts
# Sync caches metadata in SQLite; DHIS2 remains source of truth. GET-only.
# DHIS2_REPORTS_CATALOG=config/dhis2_reports.yaml
# DHIS2_REPORTS_DATABASE=data/dhis2_reports.db
# DHIS2_REPORT_OUTPUT_DIR=
# DHIS2_REPORT_ALLOWED_HOSTS=

DHIS2_TIMEOUT_SECONDS=10

# Reliability (GET-only client hardening)
DHIS2_PROBE_TIMEOUT_SECONDS=5
DHIS2_RETRY_MAX=2
DHIS2_RETRY_BACKOFF_SECONDS=0.5
DHIS2_PAGE_SIZE=100
DHIS2_MAX_PAGES=10
DHIS2_HTTP_POOL_MAXSIZE=10

# Write gate — MUST stay false. Write APIs are not implemented.
ALLOW_DHIS2_WRITES=false
