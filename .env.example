# Central Hub environment template (Phase 1)
# Copy to .env and adjust. Never commit real secrets.

CENTRAL_HUB_APP_NAME=Central Hub
CENTRAL_HUB_ENV=dev
CENTRAL_HUB_HOST=127.0.0.1
CENTRAL_HUB_PORT=8080
CENTRAL_HUB_DEBUG=true

# Absolute or relative path to the repository registry
CENTRAL_HUB_REPOSITORIES_CONFIG=config/repositories.yaml

# Default timeout for HTTP / command health probes (seconds)
CENTRAL_HUB_REQUEST_TIMEOUT=5

# DHIS2 write gate (UI banner only in Phase 1 — hub never writes)
# Keep false. Real DHIS2 adapters are not implemented yet.
ALLOW_DHIS2_WRITES=false
