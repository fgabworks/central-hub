# Central Hub environment template
# Copy to .env and adjust. Never commit real secrets.

CENTRAL_HUB_APP_NAME=Central Hub
CENTRAL_HUB_ENV=dev
CENTRAL_HUB_HOST=127.0.0.1
CENTRAL_HUB_PORT=8080
CENTRAL_HUB_DEBUG=true

# Absolute or relative path to the repository registry
CENTRAL_HUB_REPOSITORIES_CONFIG=config/repositories.yaml

# Default timeout for HTTP / command health probes (seconds)
CENTRAL_HUB_REQUEST_TIMEOUT=5

# Dashboard reuses the last health probe set for this many seconds (0 = disable cache)
CENTRAL_HUB_HEALTH_CACHE_TTL=30

# Append-only audit log (created automatically)
CENTRAL_HUB_AUDIT_LOG=data/audit/audit.jsonl

# SQLite job database (Phase 2+)
CENTRAL_HUB_DATABASE=data/hub.db

# SQL Workspace (read-only query runner)
# Connection profiles: config/sql_connections.yaml (secrets via env below)
SQL_WS_MAX_ROWS=1000
SQL_WS_STATEMENT_TIMEOUT_MS=15000
SQL_WS_PAGE_SIZE=100
# Stage read-only role (optional)
# SQL_WS_STAGE_HOST=
# SQL_WS_STAGE_PORT=5432
# SQL_WS_STAGE_DATABASE=
# SQL_WS_STAGE_USER=
# SQL_WS_STAGE_PASSWORD=
# Live read-only role (optional — UI shows a strong Live warning)
# SQL_WS_LIVE_HOST=
# SQL_WS_LIVE_PORT=5432
# SQL_WS_LIVE_DATABASE=
# SQL_WS_LIVE_USER=
# SQL_WS_LIVE_PASSWORD=

# Flask session secret (change for any shared machine)
CENTRAL_HUB_SECRET_KEY=change-me-locally

# Optional owner token (Phase 6). Leave blank for open local single-user mode.
# When set, mutating job actions require matching session/header token.
CENTRAL_HUB_OWNER_TOKEN=

# Connected Live Processing (no secrets — host/path only)
# Start LP with: python lookup/app_lookup.py  (default 127.0.0.1:5050)
LIVE_PROCESSING_BASE_URL=http://127.0.0.1:5050
LIVE_PROCESSING_PATH=C:/PMNP/pmnp-live-processing

# Optional local checkouts (leave blank → Not Cloned until set; hub never auto-clones)
DATA_SCRIPT_PATH=
REPORT_TEMPLATE_PATH=

# --- DHIS2 (read-only foundation) ---
# Leave blank to keep DHIS2 pages in "not configured" mode.
DHIS2_ENABLED=true
# Prefer canonical vars when set (any of the three switches to canonical mode).
DHIS2_BASE_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
# Or select prefixed aliases already used by Live Processing (do not commit secrets):
# DHIS2_ENVIRONMENT=stage
# STAGE_DHIS2_URL=
# STAGE_DHIS2_USERNAME=
# STAGE_DHIS2_PASSWORD=
# DHIS2_ENVIRONMENT=live
# LIVE_DHIS2_URL=
# LIVE_DHIS2_USERNAME=
# LIVE_DHIS2_PASSWORD=
DHIS2_TIMEOUT_SECONDS=10

# Reliability (GET-only client hardening)
DHIS2_PROBE_TIMEOUT_SECONDS=5
DHIS2_RETRY_MAX=2
DHIS2_RETRY_BACKOFF_SECONDS=0.5
DHIS2_PAGE_SIZE=100
DHIS2_MAX_PAGES=10
DHIS2_HTTP_POOL_MAXSIZE=10

# Write gate — MUST stay false. Write APIs are not implemented.
ALLOW_DHIS2_WRITES=false
